        "type": "local",
        "command": ["uvx", "--python", "3.12", "--from", "git+https://github.com/camucamulemon7/outlook-rag.git@v0.5.0", "outlook-rag"],
        "environment": {
          "OUTLOOK_RAG_MODEL": "Qwen/Qwen3-Embedding-8B",
